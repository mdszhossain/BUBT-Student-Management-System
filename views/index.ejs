<% layout('/layouts/boilerplate') -%>
<body>
    <br>
    <form method="GET" class="new-students-form" action="/students/new">
        <button class="add-student-btn">Add New Student</button>
    </form>
    <br>
    <form class="filter-student" method="GET" action="/students">
        <div>
            <label for="name">Name:</label>
            <input type="text" name="studentName" id="name" value="<%= query.studentName || '' %>">
        </div>
        <div>
            <label for="intake">Intake:</label>
            <input type="text" name="studentIntake" id="intake" value="<%= query.studentIntake || '' %>">
        </div>
        <div>
            <label for="classId">Id:</label>
            <input type="text" name="studentClassId" id="classId" value="<%= query.studentClassId || '' %>">
        </div>
        <div>
            <label for="department">Department:</label>
            <input type="text" name="studentDept" id="department" value="<%= query.studentDept || '' %>">
        </div>
        <div>
            <button type="submit">Search</button>
            <a href="/students"><button type="button">Clear</button></a>
        </div>
    </form>
    <br>
    <table class="student-table" border="1">
        <thead>
            <tr>
                <th>Name</th>
                <th>Department</th>
                <th>Intake</th>
                <th>Class ID</th>
                <th>Details</th>
                <th>Delete</th>
            </tr>
        </thead>
        <tbody>
            <% for(let student of allStudents) { %>
                <tr>
                    <td><%= student.studentName %></td>
                    <td><%= student.studentDept %></td>
                    <td><%= student.studentIntake %></td>
                    <td><%= student.studentClassId %></td>
                    <td>
                        <form action="/students/<%= student._id %>">
                            <button class="details-btn">Show Details</button>
                        </form>
                    </td>
                    <td>
                        <form method="POST" action="/students/<%= student._id %>?_method=DELETE" class="delete-btn-form">
                            <button class="delete-btn" type="submit">Delete</button>
                        </form>
                    </td>
                </tr>
            <% } %>
        </tbody>
    </table>
</body>